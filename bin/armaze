#!/usr/bin/env zsh
#
# armaze — pick skills and agents from the Armaze AI Stack and add them to a repo.
#
#   armaze list [skills|agents] [--names]
#   armaze add  [--to DIR] [--platform claude|generic] [--skills-dir DIR] [--agents-dir DIR]
#               [--skills] [--agents] [--force] [--link] [NAME ...]
#   armaze update [--to DIR] [--pull]
#   armaze root | help | version
#
# Environment:
#   ARMAZE_STACK_DIR   Path to the armaze-ai-stack checkout (default: the repo this script lives in)
#   ARMAZE_NO_FZF      Set to 1 to always use the numbered picker instead of fzf
#   NO_COLOR           Disable coloured output

emulate -R zsh
setopt pipe_fail extended_glob typeset_silent

readonly ARMAZE_VERSION="0.1.0"
readonly MANIFEST_NAME=".armaze-stack"
readonly -a TYPES=(skills agents)

ARMAZE_STACK_DIR="${ARMAZE_STACK_DIR:-${0:A:h:h}}"
ARMAZE_STACK_DIR="${ARMAZE_STACK_DIR:A}"

typeset -ga SELECTED

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_RESET=$'\e[0m' C_BOLD=$'\e[1m' C_DIM=$'\e[2m'
  C_RED=$'\e[31m' C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m' C_BLUE=$'\e[34m'
else
  C_RESET="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE=""
fi

info() { print -r -- "${C_BLUE}==>${C_RESET} $*" }
ok()   { print -r -- "${C_GREEN}✔${C_RESET} $*" }
warn() { print -r -u2 -- "${C_YELLOW}!${C_RESET} $*" }
die()  { print -r -u2 -- "${C_RED}error:${C_RESET} $*"; exit 1 }

# Shorten an absolute path for display: relative to $PWD when inside it, else ~-prefixed.
pretty_path() {  # <abs path>
  local p=$1
  if [[ $p == $PWD ]]; then print -r -- "."
  elif [[ $p == $PWD/* ]]; then print -r -- "${p#$PWD/}"
  else print -r -- "${p/#$HOME/~}"
  fi
}

usage() {
  cat <<USAGE
${C_BOLD}armaze${C_RESET} — add skills and agents from the Armaze AI Stack to a repo

${C_BOLD}Usage${C_RESET}
  armaze list [skills|agents] [--names]   List what the stack offers
  armaze add [options] [NAME ...]         Add components to a repo (interactive picker if no NAME)
  armaze update [--to DIR] [--pull]       Re-copy everything recorded in ${MANIFEST_NAME}
  armaze root                             Print the stack checkout path
  armaze help | version

${C_BOLD}add options${C_RESET}
  -t, --to DIR            Target repo (default: current git repo, else the current directory)
  -p, --platform NAME     Destination layout: claude (default) | generic
      --skills-dir DIR    Override where skills go (relative to the target)
      --agents-dir DIR    Override where agents go (relative to the target)
  -s, --skills            Only offer skills
  -a, --agents            Only offer agents
  -f, --force             Overwrite existing files without asking
  -l, --link              Symlink instead of copy (handy while developing a skill)

  NAME may be bare (pr-review) or qualified (skills/pr-review, agents/reviewer).

${C_BOLD}update options${C_RESET}
  -t, --to DIR            Target repo (default: current git repo, else the current directory)
      --pull              Run 'git pull --ff-only' on the stack first

${C_BOLD}Layouts${C_RESET}
  claude    .claude/skills/<name>/    .claude/agents/<name>.md
  generic   .ai/skills/<name>/        .ai/agents/<name>.md

${C_BOLD}Stack${C_RESET}  ${ARMAZE_STACK_DIR}
USAGE
}

# ---------------------------------------------------------------------------
# Stack introspection
# ---------------------------------------------------------------------------
require_stack() {
  [[ -d "$ARMAZE_STACK_DIR/skills" || -d "$ARMAZE_STACK_DIR/agents" ]] \
    || die "no stack found at $ARMAZE_STACK_DIR — set ARMAZE_STACK_DIR to your armaze-ai-stack checkout"
}

stack_rev() {
  git -C "$ARMAZE_STACK_DIR" rev-parse --short HEAD 2>/dev/null || print -r -- "unknown"
}

type_singular() { case $1 in skills) print -r -- skill ;; agents) print -r -- agent ;; esac }

# Relative destination directory for a component type under a platform layout.
dest_dir() {  # <platform> <type>
  case $1 in
    claude)  print -r -- ".claude/$2" ;;
    generic) print -r -- ".ai/$2" ;;
  esac
}

# Leaf name inside the destination directory.
dest_leaf() {  # <type> <name>
  case $1 in
    skills) print -r -- "$2" ;;
    agents) print -r -- "$2.md" ;;
  esac
}

# Source path of a component inside the stack.
component_src() {  # <type> <name>
  case $1 in
    skills) print -r -- "$ARMAZE_STACK_DIR/skills/$2" ;;
    agents) print -r -- "$ARMAZE_STACK_DIR/agents/$2.md" ;;
  esac
}

# The Markdown file carrying a component's front matter.
component_doc() {  # <type> <name>
  case $1 in
    skills) print -r -- "$ARMAZE_STACK_DIR/skills/$2/SKILL.md" ;;
    agents) print -r -- "$ARMAZE_STACK_DIR/agents/$2.md" ;;
  esac
}

component_exists() {  # <type> <name>
  case $1 in
    skills) [[ -f "$ARMAZE_STACK_DIR/skills/$2/SKILL.md" ]] ;;
    agents) [[ $2 != README && -f "$ARMAZE_STACK_DIR/agents/$2.md" ]] ;;
    *) return 1 ;;
  esac
}

# Names of available components of a type, one per line.
list_names() {  # <type>
  local type=$1 src="$ARMAZE_STACK_DIR/$type" p
  [[ -d $src ]] || return 0
  case $type in
    skills)
      for p in "$src"/[^._]*(N/); do
        [[ -f "$p/SKILL.md" ]] && print -r -- "${p:t}"
      done ;;
    agents)
      for p in "$src"/[^._]*.md(N.); do
        [[ ${p:t} == README.md ]] && continue
        print -r -- "${p:t:r}"
      done ;;
  esac
}

# One-line description from YAML front matter (`description:`), with a fallback
# to the first plain line of the body.
component_description() {  # <file>
  local file=$1 desc
  [[ -f $file ]] || return 0
  desc=$(awk '
    NR == 1 { if ($0 ~ /^---[ \t]*$/) { fm = 1; next } exit }
    !fm { exit }
    /^---[ \t]*$/ { if (block) print out; exit }
    block {
      if ($0 ~ /^[ \t]/) { sub(/^[ \t]+/, ""); out = out (length(out) ? " " : "") $0; next }
      print out; exit
    }
    /^description:/ {
      sub(/^description:[ \t]*/, "")
      if ($0 ~ /^[>|]/) { block = 1; next }
      print; exit
    }
  ' "$file")
  desc=${desc#\"}; desc=${desc%\"}; desc=${desc#\'}; desc=${desc%\'}
  if [[ -z $desc ]]; then
    desc=$(awk '
      NR == 1 && /^---/ { fm = 1; next }
      fm && /^---/ { fm = 0; next }
      !fm && NF && !/^#/ { print; exit }
    ' "$file")
  fi
  print -r -- "$desc"
}

# ---------------------------------------------------------------------------
# Target repo + manifest
# ---------------------------------------------------------------------------
resolve_target() {  # <dir-or-empty>
  local t=$1
  if [[ -z $t ]]; then
    t=$(git rev-parse --show-toplevel 2>/dev/null) || t=$PWD
  fi
  [[ -d $t ]] || die "target directory not found: $t"
  print -r -- "${t:A}"
}

# Record (or refresh) one component in the target's manifest. Entries are keyed
# by destination path, so the same component installed in two places is two rows.
manifest_upsert() {  # <target> <type> <name> <relpath>
  local file="$1/$MANIFEST_NAME" type=$2 name=$3 rel=$4
  local rev=$(stack_rev) stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  local tmp="$file.$$.tmp"
  {
    print -r -- "# Components added from armaze-ai-stack. Managed by \`armaze\`; safe to commit."
    print -r -- "# type"$'\t'"name"$'\t'"path"$'\t'"stack_rev"$'\t'"synced_utc"
    [[ -f $file ]] && awk -F'\t' -v p="$rel" '!/^#/ && $3 != p' "$file"
    print -r -- "$type"$'\t'"$name"$'\t'"$rel"$'\t'"$rev"$'\t'"$stamp"
  } > "$tmp" && mv -f -- "$tmp" "$file"
}

# ---------------------------------------------------------------------------
# Selection
# ---------------------------------------------------------------------------

# Turn "name" or "type/name" into "type<TAB>name". Dies on unknown/ambiguous input.
resolve_name() {  # <arg> <allowed types...>
  local arg=$1; shift
  local -a allowed=("$@")
  local type

  if [[ $arg == */* ]]; then
    type=${arg%%/*}; type=${type%s}s
    local name=${arg#*/}
    (( ${allowed[(Ie)$type]} )) || die "unknown component type in '$arg' (expected: ${(j:, :)allowed})"
    component_exists "$type" "$name" || die "no such $(type_singular $type): $name (run: armaze list)"
    print -r -- "$type"$'\t'"$name"
    return
  fi

  local -a hits=()
  for type in "${allowed[@]}"; do
    component_exists "$type" "$arg" && hits+=("$type")
  done
  case $#hits in
    0) die "no skill or agent named '$arg' (run: armaze list)" ;;
    1) print -r -- "${hits[1]}"$'\t'"$arg" ;;
    *) die "'$arg' is both a skill and an agent — say skills/$arg or agents/$arg" ;;
  esac
}

# Interactive multi-select for one component type. Fills the SELECTED array.
pick() {  # <type>
  local type=$1
  local -a names=("${(@f)$(list_names "$type")}"); names=("${(@)names:#}")
  SELECTED=()
  if (( ! $#names )); then
    print -r -- "${C_DIM}no ${type} in the stack yet${C_RESET}"
    return 0
  fi

  local -a rows=()
  local name desc
  for name in "${names[@]}"; do
    desc=$(component_description "$(component_doc "$type" "$name")")
    rows+=("$(printf '%-28s %s' "$name" "${desc:-}")")
  done

  if (( $+commands[fzf] )) && [[ -z "${ARMAZE_NO_FZF:-}" ]]; then
    SELECTED=("${(@f)$(printf '%s\n' "${rows[@]}" \
      | fzf --multi --reverse --height=60% \
            --prompt="${type}> " \
            --header="TAB to mark, ENTER to confirm, ESC to skip ${type}" \
      | cut -d' ' -f1)}")
    SELECTED=("${(@)SELECTED:#}")
    return 0
  fi

  print -r -- "${C_BOLD}Available ${type}${C_RESET}"
  local i
  for (( i = 1; i <= $#names; i++ )); do
    printf '  %2d) %s\n' "$i" "${rows[i]}"
  done
  local answer
  print -n -- "Pick ${type} — numbers or ranges (e.g. 1 3-4), 'a' for all, blank to skip: "
  read -r answer
  local -a picks=(${(s:,:)${answer// /,}})
  local tok lo hi
  for tok in "${picks[@]}"; do
    if [[ $tok == (a|all) ]]; then SELECTED=("${names[@]}"); break; fi
    if [[ $tok == <->-<-> ]]; then lo=${tok%-*}; hi=${tok#*-}
    elif [[ $tok == <-> ]]; then lo=$tok; hi=$tok
    else warn "ignoring '$tok'"; continue
    fi
    for (( i = lo; i <= hi; i++ )); do
      (( i >= 1 && i <= $#names )) && SELECTED+=("${names[i]}")
    done
  done
  SELECTED=("${(@u)SELECTED}")
}

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------

# Copy or link one component to <dest>. Returns 0 installed, 1 failed, 2 skipped.
install_one() {  # <type> <name> <dest> <force 0|1> <copy|link>
  local type=$1 name=$2 dest=$3 force=$4 mode=$5
  local src=$(component_src "$type" "$name")
  local shown=$(pretty_path "$dest")

  component_exists "$type" "$name" || { warn "no such $(type_singular $type): $name"; return 1 }

  if [[ -e $dest || -L $dest ]]; then
    if [[ -L $dest && ${dest:A} == ${src:A} ]]; then
      ok "$(type_singular $type) ${C_BOLD}$name${C_RESET} already linked → $shown"
      return 0
    fi
    if (( ! force )); then
      if [[ -t 0 && -t 1 ]]; then
        local ans
        if ! read -q "ans?  ${C_YELLOW}$shown exists${C_RESET} — overwrite? [y/N] "; then
          print; print -r -- "  ${C_DIM}skipped $name${C_RESET}"
          return 2
        fi
        print
      else
        warn "skipping $name — $shown exists (use --force to overwrite)"
        return 2
      fi
    fi
    rm -rf -- "$dest"
  fi

  mkdir -p -- "${dest:h}" || { warn "cannot create ${dest:h}"; return 1 }
  case $mode in
    link) ln -s -- "$src" "$dest" ;;
    *)    if [[ -d $src ]]; then cp -R -- "$src" "$dest"; else cp -- "$src" "$dest"; fi ;;
  esac || { warn "failed to install $name"; return 1 }

  ok "$(type_singular $type) ${C_BOLD}$name${C_RESET} → $shown${${(M)mode:#link}:+ ${C_DIM}(symlink)${C_RESET}}"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_list() {
  require_stack
  local names_only=0
  local -a types=()
  while (( $# )); do
    case $1 in
      --names)      names_only=1 ;;
      skills|skill) types+=(skills) ;;
      agents|agent) types+=(agents) ;;
      -h|--help)    usage; return 0 ;;
      *)            die "unknown argument '$1' (expected: skills, agents, --names)" ;;
    esac
    shift
  done
  (( $#types )) || types=("${TYPES[@]}")
  types=("${(@u)types}")

  local type name desc
  for type in "${types[@]}"; do
    local -a names=("${(@f)$(list_names "$type")}"); names=("${(@)names:#}")
    if (( names_only )); then
      for name in "${names[@]}"; do print -r -- "$type/$name"; done
      continue
    fi
    print -r -- "${C_BOLD}${type}${C_RESET} ${C_DIM}(${#names})${C_RESET}"
    if (( ! $#names )); then
      print -r -- "  ${C_DIM}none yet${C_RESET}"; print
      continue
    fi
    for name in "${names[@]}"; do
      desc=$(component_description "$(component_doc "$type" "$name")")
      printf '  %-28s %s\n' "$name" "${C_DIM}${desc:-—}${C_RESET}"
    done
    print
  done
}

cmd_add() {
  require_stack
  local target="" platform=claude force=0 mode=copy skills_dir="" agents_dir=""
  local -a types=() names=()
  while (( $# )); do
    case $1 in
      -t|--to)        [[ -n ${2:-} ]] || die "$1 needs a value"; target=$2; shift 2 ;;
      -p|--platform)  [[ -n ${2:-} ]] || die "$1 needs a value"; platform=$2; shift 2 ;;
      --skills-dir)   [[ -n ${2:-} ]] || die "$1 needs a value"; skills_dir=$2; shift 2 ;;
      --agents-dir)   [[ -n ${2:-} ]] || die "$1 needs a value"; agents_dir=$2; shift 2 ;;
      -s|--skills)    types+=(skills); shift ;;
      -a|--agents)    types+=(agents); shift ;;
      -f|--force)     force=1; shift ;;
      -l|--link)      mode=link; shift ;;
      -h|--help)      usage; return 0 ;;
      --)             shift; names+=("$@"); break ;;
      -*)             die "unknown option '$1' (run: armaze help)" ;;
      *)              names+=("$1"); shift ;;
    esac
  done
  (( $#types )) || types=("${TYPES[@]}")
  types=("${(@u)types}")
  [[ $platform == (claude|generic) ]] || die "unknown platform '$platform' (expected: claude, generic)"

  target=$(resolve_target "$target") || exit 1
  [[ $target == $ARMAZE_STACK_DIR ]] \
    && die "the target is the stack itself — cd into your own repo or pass --to DIR"

  local -A dest_rel
  dest_rel[skills]=${skills_dir:-$(dest_dir "$platform" skills)}
  dest_rel[agents]=${agents_dir:-$(dest_dir "$platform" agents)}

  info "stack   $(pretty_path "$ARMAZE_STACK_DIR") ${C_DIM}($(stack_rev))${C_RESET}"
  info "target  $(pretty_path "$target") ${C_DIM}(layout: $platform)${C_RESET}"
  print

  local -a queue=()
  local type name entry
  if (( $#names )); then
    for name in "${names[@]}"; do
      entry=$(resolve_name "$name" "${types[@]}") || exit 1
      queue+=("$entry")
    done
  else
    for type in "${types[@]}"; do
      pick "$type"
      for name in "${SELECTED[@]}"; do queue+=("$type"$'\t'"$name"); done
    done
    print
  fi
  queue=("${(@u)queue}")
  if (( ! $#queue )); then
    print -r -- "Nothing selected."
    return 0
  fi

  local added=0 skipped=0 rel
  for entry in "${queue[@]}"; do
    type=${entry%%$'\t'*}; name=${entry#*$'\t'}
    rel="${dest_rel[$type]}/$(dest_leaf "$type" "$name")"
    if install_one "$type" "$name" "$target/$rel" "$force" "$mode"; then
      manifest_upsert "$target" "$type" "$name" "$rel"
      (( added += 1 ))
    else
      (( skipped += 1 ))
    fi
  done
  print
  if (( added )); then
    ok "$added added, $skipped skipped — recorded in $(pretty_path "$target/$MANIFEST_NAME")"
  else
    ok "$added added, $skipped skipped"
  fi
}

cmd_update() {
  require_stack
  local target="" pull=0
  while (( $# )); do
    case $1 in
      -t|--to)   [[ -n ${2:-} ]] || die "$1 needs a value"; target=$2; shift 2 ;;
      --pull)    pull=1; shift ;;
      -h|--help) usage; return 0 ;;
      *)         die "unknown option '$1' (run: armaze help)" ;;
    esac
  done

  target=$(resolve_target "$target") || exit 1
  local manifest="$target/$MANIFEST_NAME"
  [[ -f $manifest ]] || die "no $MANIFEST_NAME in $target — nothing to update (run: armaze add)"

  if (( pull )); then
    info "pulling latest stack"
    git -C "$ARMAZE_STACK_DIR" pull --ff-only || die "git pull failed"
  fi
  info "stack   $(pretty_path "$ARMAZE_STACK_DIR") ${C_DIM}($(stack_rev))${C_RESET}"
  info "target  $(pretty_path "$target")"
  print

  local -a entries=("${(@f)$(grep -v '^#' "$manifest")}"); entries=("${(@)entries:#}")
  if (( ! $#entries )); then
    print -r -- "Manifest is empty."
    return 0
  fi

  local line type name rel rest dest src updated=0 unchanged=0 failed=0
  for line in "${entries[@]}"; do
    IFS=$'\t' read -r type name rel rest <<< "$line"
    if [[ -z $type || -z $name || -z $rel ]]; then
      warn "skipping malformed manifest line: $line"; (( failed += 1 )); continue
    fi
    dest="$target/$rel"
    src=$(component_src "$type" "$name")
    if [[ -L $dest ]]; then
      ok "$(type_singular $type) ${C_BOLD}$name${C_RESET} is a symlink — already live"
      continue
    fi
    if [[ -e $dest ]] && diff -rq -- "$src" "$dest" >/dev/null 2>&1; then
      print -r -- "  ${C_DIM}$(type_singular $type) $name up to date${C_RESET}"
      manifest_upsert "$target" "$type" "$name" "$rel"
      (( unchanged += 1 ))
      continue
    fi
    if install_one "$type" "$name" "$dest" 1 copy; then
      manifest_upsert "$target" "$type" "$name" "$rel"
      (( updated += 1 ))
    else
      (( failed += 1 ))
    fi
  done
  print
  ok "$updated updated, $unchanged already up to date, $failed failed"
  (( failed == 0 ))
}

main() {
  local cmd=${1:-help}
  (( $# )) && shift
  case $cmd in
    list|ls)               cmd_list "$@" ;;
    add|install)           cmd_add "$@" ;;
    update|upgrade)        cmd_update "$@" ;;
    root|path)             print -r -- "$ARMAZE_STACK_DIR" ;;
    help|-h|--help)        usage ;;
    version|-v|--version)  print -r -- "armaze $ARMAZE_VERSION" ;;
    *)                     die "unknown command '$cmd' (run: armaze help)" ;;
  esac
}

main "$@"
