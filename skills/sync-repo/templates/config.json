{
  "exclude": [
    ".claude",
    ".agents",
    ".cursor",
    ".codex",
    ".impeccable",
    ".playwright-mcp",
    ".mcp.json",
    ".ignore",
    ".armaze-stack",
    ".sync-repo",
    ".vercel",
    "skills-lock.json",
    "CLAUDE.md",
    "AGENTS.md",
    "PRODUCT.md",
    "FIGMA.md",
    "feature.md",
    "project-management",
    "research",
    "tasks",
    "rules",
    "tools",
    "graft"
  ],
  "divergent": [
    "package.json"
  ],
  "leakPatterns": [
    "\\b[CDQ]-\\d{3}\\b",
    "\\bT\\d{1,3}\\b",
    "\\bPhase \\d+",
    "\\bCheckpoint [A-Z]\\b",
    "[Cc]laude|CLAUDE",
    "Anthropic",
    "\\bAI agents?\\b",
    "\\bLLMs?\\b",
    "\\bMCP\\b",
    "\\b[Ss]kills?\\b",
    "[Ss]ubagent",
    "\\b[Oo]rca\\b",
    "\\bgraft\\b",
    "armaze",
    "impeccable",
    "playwright-mcp",
    "sync-repo",
    "time[- ]tracker",
    "module[- ]docs",
    "PRODUCT\\.md|feature\\.md",
    "(?<!/)\\b(rules|tasks|research)/",
    "project-management",
    "decisionlog|decision log",
    "\\b20\\d\\d-\\d\\d-\\d\\d\\b",
    "[Ff]igma",
    "FIGMA",
    "\\bI?\\d{3,5}:\\d{3,6}\\b",
    "\\b[0-9a-f]{40}\\b"
  ],
  "stringPatterns": [
    "\\b[CD]-\\d{3}\\b",
    "[Cc]laude|CLAUDE",
    "Anthropic",
    "\\bMCP\\b",
    "\\b[Oo]rca\\b",
    "\\bgraft\\b",
    "armaze",
    "impeccable",
    "(?<!/)\\b(rules|tasks|research)/",
    "project-management"
  ],
  "mirrorOwned": [
    "README.md",
    ".gitignore",
    ".github/"
  ],
  "sourceRef": "origin/main",
  "compare": {
    "app": ".",
    "command": ["pnpm", "exec", "vite", "--port", "{port}", "--strictPort"],
    "env": {},
    "sourcePort": 5173,
    "mirrorPort": 5181,
    "viewports": [
      { "name": "desktop", "width": 1440, "height": 900 },
      { "name": "phone", "width": 390, "height": 844 }
    ],
    "themes": ["light", "dark"],
    "pages": ["/"],
    "expected": {},
    "none": [
      ".md",
      ".test.ts",
      ".test.tsx",
      "eslint.config.js",
      "tsconfig",
      "vitest.config.ts",
      ".prettierrc",
      ".prettierignore",
      ".nvmrc",
      ".env.example"
    ],
    "map": {}
  }
}
